# Copy to .env for local Python development. All credential values are empty.
HOST=127.0.0.1
PORT=8080
MODE=local
COMMERCE_ENABLED=true
DATABASE_TYPE=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_USER=commerce
POSTGRES_PASSWORD=
POSTGRES_DB=agent_commerce_demo
AUTH_SECRET=
COOKIE_SECURE=false
USE_FAKE_MODEL=true
DEFAULT_MODEL=fake
DASHSCOPE_APIKEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BUSINESS_BACKEND=http
SIM_BUSINESS_URL=http://127.0.0.1:8081
SIM_FAILURE_MODE=none
ASYNC_TRANSPORT=postgres
ADMIN_STAFF_IDS=STAFF-001
